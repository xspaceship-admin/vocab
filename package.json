{
  "name": "vocab-news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn idioms, SAT vocab, and common American phrases through one AI-generated news article a day, with multiple-choice and fill-in-the-blank quizzes that track your mastery.",
  "scripts": {
    "start": "node server.js",
    "api": "PORT=5175 node server.js",
    "dev": "concurrently -n api,web -c blue,green \"npm:api\" \"vite\"",
    "build": "vite build",
    "preview": "npm run build && node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
}
